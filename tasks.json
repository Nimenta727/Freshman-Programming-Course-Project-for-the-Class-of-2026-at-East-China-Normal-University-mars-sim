{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Clang++ build active file",
      "command": "C:/msys64/ucrt64/bin/clang.exe",
      "args": [
        "-fcolor-diagnostics",
        "-fansi-escape-codes",
        "-g",
        "${file}",
        "-lgmp",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "CMake Build",
      "command": "cmake --build ${workspaceFolder}/build",
      "group": "build",
      "problemMatcher": "$gcc"
    }
  ]
}